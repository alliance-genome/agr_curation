        },
        "env": {
            "browser": true,
            "es2021": true,
            "node": true
        },
        "settings": {
            "react": {
                "version": "detect"
            }
        },
        "rules": {
            "react/react-in-jsx-scope": "off",
            "react/prop-types": "off"
        }
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
